{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"declaration": true,
		"declarationMap": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
