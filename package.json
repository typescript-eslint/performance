{
	"name": "performance",
	"version": "0.0.0",
	"private": true,
	"description": "Various performance baselines for typescript-eslint.",
	"repository": {
		"type": "git",
		"url": "https://github.com/typescript-eslint/performance"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"type": "module",
	"workspaces": [
		"cases/*"
	],
	"scripts": {
		"format": "prettier .",
		"generate": "node src/generate.ts",
		"generate:watch": "node --watch src/generate.ts",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules sentences-per-line",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"measure": "node src/measure.ts",
		"prepare": "husky",
		"tsc": "node ./node_modules/typescript/bin/tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"console-table-without-index": "^0.1.1",
		"execa": "^9.5.3",
		"prettier": "^3.5.3"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
		"@eslint/js": "^10.0.1",
		"@types/eslint-plugin-markdown": "^2.0.2",
		"@types/node": "^22.15.21",
		"cspell": "^9.0.2",
		"eslint": "^10.10.0",
		"eslint-plugin-jsdoc": "^64.3.9",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-markdown": "^5.1.0",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-package-json": "^1.8.0",
		"eslint-plugin-perfectionist": "^5.11.0",
		"eslint-plugin-regexp": "^3.3.0",
		"eslint-plugin-yml": "^3.8.1",
		"husky": "^9.1.7",
		"knip": "^5.57.0",
		"lint-staged": "^16.0.0",
		"markdownlint": "^0.38.0",
		"markdownlint-cli": "^0.45.0",
		"prettier-plugin-curly": "^0.3.2",
		"prettier-plugin-packagejson": "^2.5.14",
		"prettier-plugin-sh": "^0.17.4",
		"sentences-per-line": "^0.3.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0"
	},
	"engines": {
		"node": ">=24.21.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
