{
	"name": "performance",
	"version": "0.0.0",
	"private": true,
	"description": "Various performance baselines for typescript-eslint.",
	"repository": {
		"type": "git",
		"url": "https://github.com/typescript-eslint/performance"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"type": "module",
	"files": [
		"package.json",
		"LICENSE.md",
		"README.md"
	],
	"workspaces": [
		"cases/*"
	],
	"scripts": {
		"format": "prettier .",
		"generate": "node --import tsx/esm src/generate.ts",
		"generate:watch": "node --import tsx/esm --watch src/generate.ts",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules sentences-per-line",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"measure": "node --import tsx/esm src/measure.ts",
		"prepare": "husky",
		"tsc": "tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"console-table-without-index": "^0.1.1",
		"execa": "^9.5.3",
		"prettier": "^3.5.3"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
		"@eslint/js": "^9.27.0",
		"@types/eslint-plugin-markdown": "^2.0.2",
		"@types/node": "^22.15.21",
		"cspell": "^9.0.2",
		"eslint": "^9.27.0",
		"eslint-plugin-jsdoc": "^50.6.17",
		"eslint-plugin-jsonc": "^2.20.1",
		"eslint-plugin-markdown": "^5.1.0",
		"eslint-plugin-n": "^17.18.0",
		"eslint-plugin-package-json": "^0.31.0",
		"eslint-plugin-perfectionist": "^4.13.0",
		"eslint-plugin-regexp": "^2.7.0",
		"eslint-plugin-yml": "^1.18.0",
		"husky": "^9.1.7",
		"jsonc-eslint-parser": "^2.4.0",
		"knip": "^5.57.0",
		"lint-staged": "^16.0.0",
		"markdownlint": "^0.38.0",
		"markdownlint-cli": "^0.45.0",
		"prettier-plugin-curly": "^0.3.2",
		"prettier-plugin-packagejson": "^2.5.14",
		"prettier-plugin-sh": "^0.17.4",
		"sentences-per-line": "^0.3.0",
		"tsx": "^4.19.4",
		"typescript": "5.8.3",
		"typescript-eslint": "8.32.1"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"provenance": true
	}
}
